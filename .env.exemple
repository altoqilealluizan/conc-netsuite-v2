# =============================================================
# Credenciais NetSuite - Token-Based Authentication (TBA)
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o arquivo .env em git.
# =============================================================

# ID da conta NetSuite (o mesmo que aparece na URL: 9339456.app.netsuite.com)
NS_ACCOUNT=xxxxxxxxxx

# Integração (Setup > Integration > Manage Integrations > New)
NS_CONSUMER_KEY=XXXXXXXXXXXXXXXXXXXXX
NS_CONSUMER_SECRET=XXXXXXXXXXXXXXXXXX
# Access Token (Setup > Users/Roles > Access Tokens > New)
NS_TOKEN_ID=XXXXXXXXXXXX
NS_TOKEN_SECRET=XXXXXXXXXXXXXXX

# Opcional: TTL do cache em segundos (padrão 600 = 10 min)
CACHE_TTL=XX
